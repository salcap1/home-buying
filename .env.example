# Neon. Either name works; HOME_BUYING_STORAGE_DATABASE_URL wins if both are set.
DATABASE_URL=
HOME_BUYING_STORAGE_DATABASE_URL=

# neon today. Register another adapter in lib/data before changing this.
DATABASE_PROVIDER=neon

# Comma list of modules, or omit to use the brand catalog
# NEXT_PUBLIC_MODULES=payments,commute,schools,sell_to_buy,household_cashflow

# Org placeholder until org tables exist
DEMO_ORG_ID=demo

# Signs workspace unlock cookies. Required for sign-in / create account.
SESSION_SECRET=
